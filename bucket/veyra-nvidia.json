            "hash": "75e93716b78d59af064b3ae19e4623ffca0310339534c7aa2f3b6f89f925c2da"
        }
    },
    "pre_install": [
        "if (!(Test-Path (Join-Path $dir 'veyra_qml_ui.exe'))) {",
        "    $packages = @(Get-ChildItem -LiteralPath $dir -Directory | Where-Object { Test-Path (Join-Path $_.FullName 'veyra_qml_ui.exe') })",
        "    if ($packages.Count -ne 1) { throw 'Cannot locate Veyra portable application root.' }",
        "    Get-ChildItem -LiteralPath $packages[0].FullName -Force | Move-Item -Destination $dir -Force",
        "    Remove-Item -LiteralPath $packages[0].FullName -Force",
        "}"
    ],
    "shortcuts": [
        [
            "veyra_qml_ui.exe",
            "Veyra (NVIDIA)"
        ]
    ],
    "persist": "runtime_local/user-data-2.0.0",
    "checkver": {
        "url": "https://api.github.com/repos/Likely7/Veyra-NRVideo/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Likely7/Veyra-NRVideo/releases/download/v$version/Veyra-$version-NVIDIA-win64-portable.zip"
            }
        }
    }
}
