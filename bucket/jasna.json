    "pre_install": [
        "if (!(Test-Path (Join-Path $dir 'jasna.exe'))) {",
        "    $packages = @(Get-ChildItem -LiteralPath $dir -Directory | Where-Object { Test-Path (Join-Path $_.FullName 'jasna.exe') })",
        "    if ($packages.Count -ne 1) { throw 'Cannot locate Jasna application root after extracting the archive.' }",
        "    Get-ChildItem -LiteralPath $packages[0].FullName -Force | Move-Item -Destination $dir -Force",
        "    Remove-Item -LiteralPath $packages[0].FullName -Recurse -Force",
        "}",
        "$models = Join-Path $dir 'model_weights'",
        "$persistedModels = Join-Path (Split-Path -Parent $dir) 'persist\\model_weights'",
        "if ((Test-Path -LiteralPath $models -PathType Container) -and (Test-Path -LiteralPath $persistedModels -PathType Container)) {",
        "    Get-ChildItem -LiteralPath $models -Force | Copy-Item -Destination $persistedModels -Recurse -Force",
        "    Remove-Item -LiteralPath $models -Recurse -Force",
        "}"
    ],
    "shortcuts": [
        [
            "jasna.exe",
            "Jasna"
        ]
    ],
    "persist": "model_weights",
    "notes": [
        "NVIDIA Windows build; requires a supported GPU and recent NVIDIA driver.",
        "Use an ASCII-only installation path on a local NTFS SSD. Download size is approximately 6.5 GiB.",
